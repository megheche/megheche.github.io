---
import about from "../data/about.json";
import chapters from "../data/courseChapters.json";
import PageHeader from "../components/PageHeader.astro";
import ContentHeading from "../components/ContentHeading.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
const { id } = Astro.props;
---
<section class="page-section" id={id}>
  <div class="section-inner">
    <PageHeader kicker={about.name} title="Teaching" />
    <p class="teaching-intro">I have taught university-level courses, supervised PhD students, and mentored engineers and researchers across applied machine learning, AI, and optimization projects. My teaching and mentoring work has focused on helping students and research teams connect theoretical methods to practical problems.</p>
    <hr class="teaching-divider" />
    <article class="course-layout">
      <div class="course-overview">
        <div class="course-banner"><span>Course in preparation</span><h3>Language Models</h3></div>
        <p class="course-collaboration">In collaboration with <a href="https://perso.esiee.fr/~chierchg/" target="_blank" rel="noopener noreferrer">Giovanni Chierchia ↗</a></p>
        <p>A course introducing language models from first principles.</p>
      </div>
      <div class="course-video">
        <VideoEmbed id="dMBSh6zHt4w" title="How Do Language Models Predict What Comes Next? | Course Introduction" label="Course introduction" href="https://www.youtube.com/watch?v=dMBSh6zHt4w" />
      </div>
      <div class="course-content">
        <ContentHeading title="Course chapters" />
        <ol class="course-chapters">{chapters.map(chapter => <li><details><summary><span class="chapter-number">{String(chapter.id).padStart(2, '0')}</span><span>{chapter.title}</span><span class="chapter-chevron" aria-hidden="true">⌄</span></summary><div class="chapter-copy">{chapter.summary.map(paragraph => <p>{paragraph}</p>)}<p class="chapter-status">Coming soon</p></div></details></li>)}</ol>
      </div>
    </article>
  </div>
</section>
<style>
.teaching-intro { color: var(--muted); font-size: 16px; line-height: 1.8; margin-bottom: 32px; }
.teaching-divider { margin: 0 0 32px; border: 0; border-top: 1px solid var(--line); }
.course-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 320px); align-items: start; gap: 32px 40px; }
.course-banner { margin-bottom: 20px; }
.course-banner > span { color: var(--accent); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
.course-banner h3 { margin-top: 12px; font-size: 30px; font-weight: 500; }
.course-content { grid-column: 1; min-width: 0; }
.course-overview > p { color: var(--muted); font-size: 15px; line-height: 1.8; }
.course-video { grid-column: 2; grid-row: 1 / span 2; min-width: 0; }
.course-video :global(.video-block) { margin-top: 0; }
.course-collaboration { margin-bottom: 14px; }
.course-collaboration a { color: var(--accent); }
.course-chapters { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
.course-chapters li { border-bottom: 1px solid var(--line); }
summary { display: flex; align-items: center; gap: 14px; list-style: none; cursor: pointer; padding: 20px 0; font-size: 15px; line-height: 1.6; }
summary::-webkit-details-marker { display: none; }
.chapter-number { color: var(--accent); font-size: 12px; }
.chapter-chevron { margin-left: auto; color: var(--accent); }
details[open] .chapter-chevron { transform: rotate(180deg); }
.chapter-copy { padding: 0 0 20px 30px; }
.chapter-copy p { margin-bottom: 12px; font-size: 14px; line-height: 1.8; color: var(--muted); }
.chapter-copy .chapter-status { margin-top: 20px; font-size: 12px; color: var(--accent); }
@media(max-width:740px) {
  .course-layout { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .course-video { grid-column: 1; grid-row: auto; width: 100%; max-width: 360px; }
}
</style>
