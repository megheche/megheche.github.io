---
import Icon from "./Icon.astro";
interface PublicationLink {
  label: string;
  href: string;
}

interface Publication {
  title: string;
  authors: string[];
  year: number;
  venue?: string;
  image?: string;
  imageAlt?: string;
  imageAspectRatio?: string;
  links?: PublicationLink[];
  tags?: string[];
  badges?: string[];
  selected?: boolean;
  description?: string;
}

interface Props {
  publication: Publication;
  highlightAuthor?: string;
  headingLevel?: 2 | 3 | 4;
}

const { publication, highlightAuthor, headingLevel = 3 } = Astro.props;
const {
  title, authors, year, venue, image, imageAlt = "", imageAspectRatio, description,
  links = [], tags = [], badges = [],
} = publication;
const Heading = `h${headingLevel}` as "h2" | "h3" | "h4";
---

<article class:list={["featured-publication", image && "featured-publication--with-image"]}>
  {(image || links.length > 0) && (
    <div class="featured-publication__media">
      {image && (
        <figure class="featured-publication__figure">
          <img src={image} alt={imageAlt} loading="lazy" decoding="async" class:list={{ "cropped-image": Boolean(imageAspectRatio) }} style={imageAspectRatio ? `aspect-ratio: ${imageAspectRatio}` : undefined} />
        </figure>
      )}
      {links.length > 0 && (
        <nav class="featured-publication__links" aria-label={`Resources for ${title}`}>
          {links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              <Icon name={/^(paper|pdf|doi|bibtex|slides)$/i.test(link.label) ? "file-text" : /^(code|demo)$/i.test(link.label) ? "code" : "link"} />
              <span>{link.label}</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  )}
  <div class="featured-publication__content">
    <header>
      {badges.length > 0 && (
        <ul class="featured-publication__badges" aria-label="Distinctions">
          {badges.map((badge) => <li>{badge}</li>)}
        </ul>
      )}
      <Heading class="featured-publication__title">{title}</Heading>
      <p class="featured-publication__authors">
        {authors.map((author, index) => (
          <>{index > 0 && ", "}{author === highlightAuthor ? <strong>{author}</strong> : author}</>
        ))}
      </p>
      <p class="featured-publication__venue">{venue ? `${venue}, ${year}` : year}</p>
    </header>
    {(Astro.slots.has("default") || description) && (
      <div class="featured-publication__description">
        <slot><p>{description}</p></slot>
      </div>
    )}
    {tags.length > 0 && (
      <ul class="featured-publication__tags" aria-label="Topics">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .featured-publication { display: grid; width: 100%; min-width: 0; gap: var(--featured-publication-gap, 32px); padding: var(--featured-publication-padding, clamp(24px, 3vw, 36px)); color: var(--text); background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 16px; box-shadow: 0 16px 36px color-mix(in srgb, var(--bg) 45%, transparent); overflow-wrap: anywhere; }
  .featured-publication--with-image { grid-template-columns: minmax(0, var(--featured-publication-image-width, 1fr)) minmax(0, 2fr); align-items: start; }
  .featured-publication__media { display: flex; flex-direction: column; align-self: stretch; min-width: 0; gap: 16px; order: 1; }
  .featured-publication--with-image .featured-publication__media { order: 0; }
  .featured-publication__figure { min-width: 0; margin: 0; }
  .featured-publication__figure img { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); }
  .featured-publication__figure .cropped-image { object-fit: cover; object-position: center top; }
  .featured-publication__content { display: flex; flex-direction: column; align-self: stretch; min-width: 0; gap: 22px; }
  .featured-publication__title { font-size: clamp(24px, 2.7vw, 30px); font-weight: 600; line-height: 1.25; letter-spacing: -.025em; text-wrap: pretty; }
  .featured-publication__authors { margin-top: 16px; color: var(--text); font-size: 17px; line-height: 1.6; }
  .featured-publication__authors strong { color: var(--text); font-weight: 600; }
  .featured-publication__venue { margin-top: 8px; color: var(--muted); font-size: 14px; font-style: italic; line-height: 1.6; }
  .featured-publication__description { color: var(--muted); font-size: 17px; line-height: 1.75; }
  .featured-publication__description :global(p + p) { margin-top: 12px; }
  .featured-publication__description :global(ul), .featured-publication__description :global(ol) { padding-left: 20px; }
  .featured-publication__description :global(ul) { list-style: disc; }
  .featured-publication__links, .featured-publication__tags, .featured-publication__badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .featured-publication__links { display: flex; flex-wrap: wrap; justify-content: center; align-self: center; margin-top: auto; max-width: 100%; gap: 4px; padding: 5px; background: var(--bg); border: 1px solid var(--line); border-radius: 10px; }
  .featured-publication__links a { display: flex; align-items: center; justify-content: center; gap: 9px; min-width: 0; min-height: 42px; padding: 8px 10px; color: var(--muted); border-radius: 6px; font-size: 14px; font-weight: 600; line-height: 1.4; text-decoration: none; transition: background .18s ease, color .18s ease; }
  .featured-publication__links :global(.icon) { width: 24px; height: 24px; flex-shrink: 0; color: var(--accent); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .featured-publication__links a:hover { color: var(--accent); background: var(--accent-soft); }
  .featured-publication__links a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; background: var(--accent-soft); }
  @media (prefers-reduced-motion: reduce) {
    .featured-publication__links a { transition: none; }
  }
  .featured-publication__tags { margin-top: auto; }
  .featured-publication__tags li { padding: 5px 10px; color: var(--muted); background: var(--bg); border: 1px solid var(--line); border-radius: 20px; font-size: 13px; line-height: 1.6; }
  .featured-publication__badges { margin-bottom: 12px; }
  .featured-publication__badges li { padding: 6px 11px; color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent); border-radius: 5px; font-size: 14px; font-weight: 600; line-height: 1.5; }
  @media (max-width: 740px) {
    .featured-publication--with-image { grid-template-columns: minmax(0, 1fr); }
    .featured-publication__figure { width: 80%; max-width: 300px; align-self: center; }
  }
</style>
