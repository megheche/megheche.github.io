---
type Skill = {
  label: string;
  value: number;
  level?: string;
};

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;
---

<div class="skill-bars">
  {skills.map((skill) => (
    <div class="skill">
      <div><span>{skill.label}</span><b>{skill.level || `${skill.value}%`}</b></div>
      <i aria-hidden="true"><span style={`width:${skill.value}%`}></span></i>
    </div>
  ))}
</div>

<style>
  .skill-bars { display: grid; gap: 18px; }
  .skill > div { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; }
  .skill b { color: var(--accent); font-size: 13px; font-weight: 500; }
  .skill i { display: block; width: 100%; height: 5px; overflow: hidden; background: var(--line); border-radius: 5px; }
  .skill i span { display: block; height: 100%; background: var(--accent); border-radius: inherit; }
</style>
