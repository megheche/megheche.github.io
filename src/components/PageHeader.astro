---
import FloralTitle from "./FloralTitle.astro";
interface Props {
  id?: string;
  kicker?: string;
  title: string;
  highlight?: string;
}

const { id, kicker, title, highlight } = Astro.props;
---

<header class="page-title">
  {kicker && <span class="section-kicker">{kicker}</span>}
  <h2 id={id}><FloralTitle title={title} />{highlight && <> <span class="title-highlight">{highlight}</span></>}</h2>
</header>

<style>
  .page-title { margin-bottom: 44px; }
  .page-title h2 { color: var(--text); position: relative; display: inline-block; font-size: clamp(32px, 4vw, 46px); font-weight: 600; letter-spacing: -.045em; line-height: 1.12; }
  .page-title h2::after { content: ""; display: block; width: 100%; height: 2px; margin-top: 16px; background: linear-gradient(90deg, var(--accent) 0 35%, transparent 35%); }
  .page-title h2 > .title-highlight { color: var(--accent); font-style: normal; }
  .section-kicker { display: block; margin-bottom: 10px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .16em; line-height: 1.4; text-transform: uppercase; }


  @media (max-width: 740px) {
    .page-title { margin-bottom: 34px; }
    .page-title h2 { font-size: 34px; }
  }
</style>
