<dialog class="photo-gallery" aria-label="Photo gallery">
  <div class="gallery-viewer">
    <button class="gallery-close" type="button" aria-label="Close photo gallery" autofocus>×</button>
    <button class="gallery-previous" type="button" aria-label="Previous photo">‹</button>
    <figure>
      <img class="gallery-image" alt="" draggable="false" />
      <figcaption aria-live="polite" aria-atomic="true">
        <span class="gallery-caption"></span>
        <span class="gallery-count"></span>
      </figcaption>
    </figure>
    <button class="gallery-next" type="button" aria-label="Next photo">›</button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.photo-gallery')!;
  const image = dialog.querySelector<HTMLImageElement>('.gallery-image')!;
  const caption = dialog.querySelector<HTMLElement>('.gallery-caption')!;
  const count = dialog.querySelector<HTMLElement>('.gallery-count')!;
  const previous = dialog.querySelector<HTMLButtonElement>('.gallery-previous')!;
  const next = dialog.querySelector<HTMLButtonElement>('.gallery-next')!;
  let photos: HTMLAnchorElement[] = [];
  let index = 0;
  let trigger: HTMLAnchorElement | null = null;
  let touchStart: { x: number; y: number } | null = null;

  function showPhoto(position: number) {
    index = (position + photos.length) % photos.length;
    const photo = photos[index];
    image.src = photo.href;
    image.alt = photo.querySelector('img')?.alt || '';
    caption.textContent = photo.dataset.caption || image.alt;
    count.textContent = `${index + 1} / ${photos.length}`;
    previous.hidden = next.hidden = photos.length < 2;
  }

  document.addEventListener('click', event => {
    const photo = event.target instanceof Element
      ? event.target.closest<HTMLAnchorElement>('[data-gallery-photo]') : null;
    if (!photo || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const article = photo.closest('[data-post]');
    if (!article) return;
    event.preventDefault();
    photos = [...article.querySelectorAll<HTMLAnchorElement>('[data-gallery-photo]')]
      .filter(link => link.getClientRects().length > 0);
    trigger = photo;
    showPhoto(photos.indexOf(photo));
    dialog.showModal();
  });

  previous.addEventListener('click', () => showPhoto(index - 1));
  next.addEventListener('click', () => showPhoto(index + 1));
  dialog.querySelector('.gallery-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', event => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    event.preventDefault();
    showPhoto(index + (event.key === 'ArrowRight' ? 1 : -1));
  });
  dialog.addEventListener('touchstart', event => {
    touchStart = event.touches.length === 1
      ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : null;
  }, { passive: true });
  dialog.addEventListener('touchend', event => {
    if (!touchStart || event.touches.length || !event.changedTouches.length) return;
    const dx = event.changedTouches[0].clientX - touchStart.x;
    const dy = event.changedTouches[0].clientY - touchStart.y;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) showPhoto(index + (dx < 0 ? 1 : -1));
    touchStart = null;
  }, { passive: true });
  dialog.addEventListener('touchcancel', () => { touchStart = null; }, { passive: true });
  dialog.addEventListener('close', () => {
    touchStart = null;
    if (trigger && !trigger.closest('[hidden], [inert]')) trigger.focus({ preventScroll: true });
    image.removeAttribute('src');
  });
  window.addEventListener('hashchange', () => { if (dialog.open) dialog.close(); });
</script>

<style>
  .photo-gallery { position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; height: 100dvh; max-height: none; margin: 0; padding: 64px 20px 24px; border: 0; background: rgb(10 14 22 / .96); color: #fff; overflow: auto; overscroll-behavior: contain; }
  .photo-gallery::backdrop { background: rgb(0 0 0 / .8); }
  .gallery-viewer { display: grid; grid-template-columns: 48px minmax(0, 1fr) 48px; align-items: center; gap: 16px; width: min(100%, 1400px); min-height: 100%; margin: auto; pointer-events: none; }
  figure { display: flex; flex-direction: column; align-items: center; gap: 18px; min-width: 0; margin: 0; }
  .gallery-image { display: block; max-width: 100%; max-height: calc(100dvh - 190px); width: auto; height: auto; object-fit: contain; pointer-events: auto; }
  figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; width: 100%; color: #eee; font-size: 16px; line-height: 1.5; pointer-events: auto; }
  .gallery-count { flex-shrink: 0; color: #ccc; font-variant-numeric: tabular-nums; }
  button { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 1px solid #ffffff60; border-radius: 50%; background: #ffffff15; color: #fff; font: inherit; font-size: 36px; line-height: 1; cursor: pointer; pointer-events: auto; touch-action: manipulation; }
  button:hover { background: #ffffff30; }
  button:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .gallery-close { position: absolute; top: 12px; right: 20px; }
  @media (max-width: 600px) {
    .photo-gallery { padding-inline: 12px; }
    .gallery-viewer { grid-template-columns: 1fr 1fr; gap: 20px; align-content: center; }
    figure { grid-column: 1 / -1; grid-row: 1; }
    .gallery-image { max-height: calc(100dvh - 270px); }
    .gallery-previous { justify-self: end; }
    figcaption { gap: 12px; }
  }
</style>
