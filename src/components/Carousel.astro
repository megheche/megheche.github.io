---
import Icon from "./Icon.astro";
interface Props {
  label: string;
  controls?: "arrows" | "dots";
  controlsPosition?: "top" | "bottom";
  controlsAlign?: "left" | "center" | "right";
}

const {
  label, controls = "arrows",
  controlsPosition = controls === "dots" ? "top" : "bottom",
  controlsAlign = controls === "dots" ? "right" : "center",
} = Astro.props;
const layout = controlsPosition === "top" ? ["controls", "slides"] : ["slides", "controls"];
---

<div class="carousel" data-carousel data-carousel-label={label} data-carousel-mode={controls}>
  {layout.map((part) => part === "slides" ? (
    <div class="carousel__viewport" data-carousel-viewport><slot /></div>
  ) : (
    <div
      class:list={["carousel__controls", `carousel__controls--${controls}`, `carousel__controls--${controlsPosition}`, `carousel__controls--${controlsAlign}`]}
      data-carousel-controls hidden
    >
      {controls === "dots" ? (
        <div class="carousel__indicators" data-carousel-indicators role="group" aria-label="Choose a slide"></div>
      ) : (
        <div class="carousel__navigation">
          <button type="button" data-carousel-previous aria-label="Previous slide">
            <Icon name="chevron-left" />
          </button>
          <span class="carousel__counter" data-carousel-counter aria-hidden="true"></span>
          <button type="button" data-carousel-next aria-label="Next slide">
            <Icon name="chevron-right" />
          </button>
        </div>
      )}
    </div>
  ))}
  <span class="carousel__status" data-carousel-status role="status" aria-live="polite" aria-atomic="true" hidden></span>
</div>

<script>
  import "../scripts/carousel.js";
</script>

<style>
  .carousel { position: relative; min-width: 0; }
  .carousel__viewport { display: grid; gap: 24px; min-width: 0; }
  .carousel--enhanced .carousel__viewport { gap: 0; }
  .carousel--enhanced .carousel__viewport > :global(.carousel__slide) { display: flex; grid-area: 1 / 1; min-width: 0; visibility: hidden; pointer-events: none; }
  .carousel--enhanced .carousel__viewport > :global(.carousel__slide) > :global(*) { flex: 1; min-width: 0; }
  .carousel--enhanced .carousel__viewport > :global(.carousel__slide--active) { visibility: visible; pointer-events: auto; }
  .carousel__controls { display: flex; max-width: 100%; }
  .carousel__controls--top { margin-bottom: 20px; }
  .carousel__controls--bottom { margin-top: 20px; }
  .carousel__controls--left { justify-content: flex-start; }
  .carousel__controls--center { justify-content: center; }
  .carousel__controls--right { justify-content: flex-end; }
  .carousel__controls--dots { position: absolute; right: 0; left: 0; z-index: 2; margin: 0; }
  .carousel__controls--dots.carousel__controls--top { bottom: calc(100% + 4px); }
  .carousel__controls--dots.carousel__controls--bottom { top: calc(100% + 4px); }
  .carousel__controls--left .carousel__indicators { justify-content: flex-start; }
  .carousel__controls--center .carousel__indicators { justify-content: center; }
  .carousel__controls--right .carousel__indicators { justify-content: flex-end; }
  .carousel__controls[hidden] { display: none; }
  .carousel__navigation { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; }
  .carousel__navigation button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; color: var(--muted); background: var(--panel); border: 1px solid var(--line); border-radius: 50%; cursor: pointer; }
  .carousel__navigation button:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .carousel__navigation :global(.icon) { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .carousel__counter { min-width: 5ch; color: var(--muted); text-align: center; font-size: 14px; font-variant-numeric: tabular-nums; }
  .carousel__indicators { display: flex; flex-wrap: wrap; justify-content: flex-end; max-width: 100%; }
  .carousel__indicators > :global(button) { display: grid; place-items: center; width: 18px; height: 24px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .carousel__indicators > :global(button)::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }
  .carousel__indicators > :global(button[aria-current="true"])::before { width: 10px; height: 10px; background: var(--accent); }
  .carousel__indicators > :global(button:hover)::before { background: var(--accent); }
  .carousel__navigation button:focus-visible, .carousel__indicators > :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .carousel__status { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
</style>
