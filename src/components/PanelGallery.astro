---
const photos = [
  { name: 'discussion', caption: 'The conversation continues', alt: 'Three panelists exchanging thoughts in front of the windows and green curtains.' },
  { name: 'ideas', caption: 'Sharing ideas', alt: 'A panelist speaking with her hands as fellow speakers listen beside the event screen.' },
  { name: 'perspectives', caption: 'Different perspectives', alt: 'A side view of the panel, with one speaker gesturing as the others listen.', portrait: true },
  { name: 'together', caption: 'Together in Zurich', alt: 'Six event participants smiling together for a group photograph.' },
  { name: 'poster', src: '/articles/zurich-robotics-panel.png', width: 1050, height: 1324, caption: 'Why Zurich is built for robotics', alt: 'Why Zurich is built for robotics panel poster featuring moderator Kateryna Portmann and panelists Yulia Sandamirskaya, Mireille El Gheche, Nicole Zingg, Andie Zhang, and Friederike Hoffmann.' },
];
---

<aside class="panel-gallery" aria-label="Photos from the Zurich robotics panel">
  <p class="gallery-label">Moments from the panel <span>{photos.length} photos</span></p>
  <div class="gallery-photos">
    {photos.map((photo, index) => <figure class="gallery-photo">
      <a href={photo.src || `/articles/zurich-panel/${photo.name}-1200.webp`} target="_blank" rel="noopener noreferrer" aria-label={`${photo.caption} — open larger photo`}>
        <img src={photo.src || `/articles/zurich-panel/${photo.name}-600.webp`}
          srcset={photo.src ? undefined : `/articles/zurich-panel/${photo.name}-600.webp 600w, /articles/zurich-panel/${photo.name}-1200.webp 1200w`}
          sizes="(max-width: 850px) calc(100vw - 50px), 400px" width={photo.width || 600} height={photo.height || (photo.portrait ? 800 : 450)}
          alt={photo.alt} loading="lazy" decoding="async" />
      </a>
      <figcaption><span>{String(index + 1).padStart(2, '0')} / {String(photos.length).padStart(2, '0')}</span>{photo.caption}</figcaption>
    </figure>)}
  </div>
</aside>

<style>
  .panel-gallery { min-width: 0; padding-top: 12px; }
  .gallery-label { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 16px; color: var(--accent); font-size: 12px; font-weight: 600; }
  .gallery-label span { color: var(--muted); font-weight: 400; white-space: nowrap; }
  .gallery-photos { display: grid; gap: 32px; }
  .gallery-photo { margin: 0; min-width: 0; }
  .gallery-photo a { display: block; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; cursor: zoom-in; }
  .gallery-photo img { width: 100%; height: auto; }
  figcaption { display: flex; align-items: baseline; gap: 12px; margin-top: 12px; color: var(--muted); font-size: 12px; line-height: 1.7; }
  figcaption span { flex-shrink: 0; font-size: 10px; color: var(--accent); font-variant-numeric: tabular-nums; letter-spacing: .08em; }
</style>
