---
interface Props {
  /** Portrait image URL and accessible description. */
  photo: string;
  alt?: string;
}

const { photo, alt = "Portrait" } = Astro.props;
---

<div class="hero-photo-column">
    <div class="hero-photo-wrap">
      <img class="hero-photo" src={photo} alt={alt} fetchpriority="high" />
    </div>
</div>

<style>
  .hero-photo-column { display: flex; min-width: 0; flex-direction: column; align-items: center; }
  .hero-photo-wrap { position: relative; isolation: isolate; width: min(100%, clamp(100px, 26vw, 200px)); aspect-ratio: 1; }
  .hero-photo-wrap::before { position: absolute; z-index: -1; inset: -6%; border-radius: 50%; content: ""; }
  .hero-photo { width: 100%; height: 100%; border: 4px solid var(--line); border-radius: 50%; object-fit: cover; object-position: center; }


  @media (max-width: 740px) {
    .hero-photo-wrap { width: min(100%, clamp(150px, 42vw, 220px)); }
  }

  @media (max-width: 480px) {
    .photo-socials { margin-top: 16px; }
  }
</style>
