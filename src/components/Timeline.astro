---
type ResumeLink = {
  label: string;
  href: string;
  type?: "page" | "download";
};

type ResumeEntry = {
  date: string;
  title: string;
  organization: string;
  description: string;
  links?: ResumeLink[];
};

interface Props {
  items: ResumeEntry[];
}

const { items } = Astro.props;
---

<div class="timeline">
  {items.map((entry) => (
    <article class="timeline-item">
      <div class="timeline-date">{entry.date}</div>
      <div class="timeline-marker"></div>
      <div class="timeline-copy">
        <h4>{entry.title}</h4>
        <strong>{entry.organization}</strong>
        <p>{entry.description}</p>
        {(entry.links ?? []).length > 0 && (
          <ul class="timeline-links">
            {(entry.links ?? []).map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer"
                   download={link.type === "download" ? true : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .timeline { position: relative; padding-left: 28px; }
  .timeline::before { content: ""; position: absolute; left: 6px; top: 7px; bottom: 6px; width: 1px; background: var(--line); }
  .timeline-item { position: relative; display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 17px; padding: 0 0 32px; }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-date { color: var(--accent); font-size: 16px; line-height: 1.4; }
  .timeline-marker { position: absolute; top: 3px; left: -27px; width: 11px; height: 11px; border: 2px solid var(--accent); border-radius: 50%; background: var(--bg); }
  .timeline-copy h4 { margin-bottom: 8px; font-size: 18px; font-weight: 500; }
  .timeline-copy strong { display: block; margin-bottom: 8px; color: var(--muted); font-size: 14px; font-weight: 500; }
  .timeline-copy p { color: var(--muted); font-size: 14px; line-height: 1.5; }
  .timeline-links { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 5px; }
  .timeline-links a { color: var(--accent); font-size: 14px; text-decoration: underline; text-underline-offset: 3px; }
  .timeline-links a:hover, .timeline-links a:focus-visible { color: var(--text); }

  @media (max-width: 740px) {
    .timeline-item { grid-template-columns: 82px minmax(0, 1fr); gap: 12px; }
  }

  @media (max-width: 480px) {
    .timeline-item { grid-template-columns: 1fr; gap: 4px; padding-bottom: 27px; }
    .timeline-date { font-size: 11px; }
    .timeline-copy { padding-left: 0; }
    .timeline-marker { top: 4px; left: -27px; }
  }
</style>
