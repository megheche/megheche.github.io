---
import FloralTitle from "./FloralTitle.astro";
interface PortfolioItem {
  title: string;
  image?: string;
  excerpt?: string;
  alt?: string;
  label?: string;
  category?: string;
  icon?: string;
  href?: string;
}

interface Props {
  items: PortfolioItem[];
  filters?: { id: string; label: string }[];
  /** Number of desktop columns; tablet and phone layouts use two and one. */
  columns?: number;
}

const { items, filters = [], columns = 3 } = Astro.props;
if (!Number.isInteger(columns) || columns < 1) throw new Error("PortfolioGrid columns must be a positive integer.");
for (const item of items) {
  if (item.href && !/^(https?:\/\/|#blog\/)/i.test(item.href)) {
    throw new Error(`PortfolioGrid: "${item.title}" must use an HTTP(S) URL or blog entry link.`);
  }
}
---

<div data-portfolio>
  {filters.length > 0 && (
    <div class="portfolio-toolbar" role="group" aria-label="Filter by category" hidden>
      {filters.map((filter) => (
        <button class="filter-button" type="button" data-filter={filter.id} aria-pressed="false">{filter.label}</button>
      ))}
    </div>
  )}
  <div class="portfolio-grid" style={`--portfolio-columns: ${columns}`}>
    {items.map((item) => {
      const Card = item.href ? "a" : "article";
      return (
        <Card class="portfolio-card" data-category={item.category} href={item.href} target={item.href?.startsWith("http") ? "_blank" : undefined} rel={item.href?.startsWith("http") ? "noopener noreferrer" : undefined}>
          <div class="portfolio-image">
            {item.image ? <>
              <template data-deferred-image><img src={item.image} alt={item.alt ?? ""} loading="lazy" decoding="async" /></template>
              <noscript><img src={item.image} alt={item.alt ?? ""} loading="lazy" decoding="async" /></noscript>
            </> : <div class="portfolio-placeholder"><span>{item.category === 'talk' ? 'Talk' : item.category === 'interview' ? 'Interview' : 'Notes & ideas'}</span><span aria-hidden="true">{item.category === 'talk' || item.category === 'interview' ? '▷' : '✎'}</span></div>}
            {item.icon && <span class="portfolio-icon" aria-hidden="true">{item.icon}</span>}
          </div>
          <div class="portfolio-copy"><h3 title={item.title}>{item.href?.startsWith('#blog/') ? <FloralTitle title={item.title} /> : item.title}</h3><span class="portfolio-label">{item.label}</span><p>{item.excerpt}</p><span class="portfolio-action">Read more ↗</span></div>
        </Card>
      );
    })}
  </div>
</div>

<script>
  import "../scripts/portfolio-grid.js";
</script>

<style>
  [data-portfolio] [hidden] { display: none; }
  /* Category filters */
  .portfolio-toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin: -14px 0 27px; }
  .filter-button { padding: 9px 12px; color: var(--muted); background: transparent; border: 1px solid var(--line); border-radius: 6px; font-size: 14px; font-weight: 500; transition: .2s ease; cursor: pointer; }
  .filter-button:hover, .filter-button.is-active { color: var(--text); background: var(--accent-soft); border-color: var(--accent); }
  /* Project cards and image overlays */
  .portfolio-grid { display: grid; grid-template-columns: repeat(var(--portfolio-columns), minmax(0, 1fr)); gap: 18px; }
  .portfolio-card { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; overflow: hidden; background: var(--panel); border: 1px solid var(--line); border-radius: 11px; transition: transform .24s ease, border-color .24s ease; }
  .portfolio-card:hover { border-color: var(--accent); transform: translateY(-5px); }
  .portfolio-grid [hidden] { display: none; }
  a.portfolio-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .portfolio-placeholder { display: flex; align-items: center; justify-content: space-between; height: 100%; padding: 26px; color: var(--accent); background: var(--accent-soft); }
  .portfolio-placeholder span:first-child { font-size: 12px; text-transform: uppercase; letter-spacing: .14em; }
  .portfolio-placeholder span:last-child { font-size: 62px; }
  .portfolio-card p { margin-top: 14px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .portfolio-card .portfolio-action { margin-top: 20px; font-size: 12px; }
  .portfolio-image { position: relative; aspect-ratio: 1 / .82; overflow: hidden; background: var(--panel); }
  .portfolio-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .portfolio-image img[src="/articles/coming-soon.png"] { object-fit: contain; padding: 12px; }
  .portfolio-card:hover .portfolio-image img { transform: scale(1.06); }
  .portfolio-card[href="#blog/systain3r-best-mentor"] .portfolio-image img { object-fit: cover; object-position: center 38%; transform: scale(1.08); }
  .portfolio-card[href="#blog/supelec-masters-graduation"] .portfolio-image img { position: absolute; width: 250%; max-width: none; height: auto; left: -75%; top: -27%; transform: none; }
  .portfolio-card[href="#blog/phd-defense"] .portfolio-image img { position: absolute; width: 400%; max-width: none; height: auto; aspect-ratio: 4 / 3; left: -160%; top: -177%; transform: none; }
  .portfolio-card[href="#blog/icip-2022-organizing"] .portfolio-image img { object-fit: cover; object-position: center 65%; transform: scale(1.08); }
  .portfolio-card[href="#blog/lebanese-university-graduation"] .portfolio-image img { object-position: center 20%; }
  .portfolio-card[href="#blog/lebanon-tech-talk"] .portfolio-image img { object-fit: cover; object-position: center 40%; transform: none; }
  .portfolio-card[href="#blog/teens-in-ai-iwd-2024"] .portfolio-image img { object-fit: cover; object-position: center 42%; transform: translateY(-10%) scale(1.25); transform-origin: center 42%; }
  .portfolio-card[href="#blog/physical-intelligence"] .portfolio-image img { object-position: center top; transform: none; }
  .portfolio-card[href="#blog/100-women-ai-robotics-switzerland"] .portfolio-image img { object-fit: cover; object-position: center 12%; transform: none; }
  .portfolio-card[href="#blog/why-zurich-is-built-for-robotics"] .portfolio-image { background: #0d1b2a; }
  .portfolio-card[href="#blog/why-zurich-is-built-for-robotics"] .portfolio-image img { object-fit: cover; object-position: 50% 48%; transform: scale(1.12); }
  .portfolio-card[href="#blog/robotics-documentary"] .portfolio-image img { transform: scale(1.32); transform-origin: 50% 40%; }
  .portfolio-card[href="#blog/robotics-documentary"]:hover .portfolio-image img { transform: scale(1.38); }
  .portfolio-icon { position: absolute; right: 12px; bottom: 12px; z-index: 1; display: grid; place-items: center; width: 30px; height: 30px; color: var(--text); background: var(--bg); border-radius: 50%; font-size: 16px; }
  .portfolio-copy { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; padding: 15px 16px 16px; }
  .portfolio-card h3 { grid-row: 1; font-size: 18px; font-weight: 500; line-height: 1.6; height: 3.2em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .portfolio-label { grid-row: 2; line-height: 1.6; height: 3.2em; overflow: hidden; }
  .portfolio-copy p { grid-row: 3; height: 5.1em; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  .portfolio-copy .portfolio-action { grid-row: 4; }
  .portfolio-card > div:last-child > span { display: block; margin-top: 5px; color: var(--accent); font-size: 13px; }

  @media (max-width: 740px) {
    .portfolio-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .portfolio-toolbar { margin-top: -8px; }
  }
  @media (max-width: 480px) {
    .portfolio-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-card, .portfolio-image img { transition: none; }
    .portfolio-card:hover, .portfolio-card:hover .portfolio-image img { transform: none; }
    .portfolio-card[href="#blog/robotics-documentary"]:hover .portfolio-image img { transform: scale(1.32); }
  }
</style>
